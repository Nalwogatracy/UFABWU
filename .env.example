# Copy this file to .env and fill in your real values.

# Which emails receive contact messages, grievance tickets and
# membership alerts (the UFABWU secretariat inbox). Multiple addresses:
# separate them with commas, e.g.  a@gmail.com, b@gmail.com, c@yahoo.com
SECRETARIAT_EMAIL=wafananelson3@gmail.com, olivejanetgidudu@gmail.com, ambolive@yahoo.com

# --- Turso (free cloud SQLite database) ---
# Leave unset for local development (uses data/ufabwu.db instead).
# Used on Vercel so data persists across serverless restarts.
#   Signup: https://turso.tech -> Create Database -> copy URL + Generate Token
TURSO_URL=
TURSO_AUTH_TOKEN=

# --- Brevo (free SMTP relay, 300 emails/day, no domain needed) ---
#   Signup: https://www.brevo.com
#   Get your SMTP Login + master key: top-right menu -> SMTP & API -> SMTP tab
#   Verify a sender: top-right menu -> Senders, Domains & Dedicated IPs
#     -> Senders -> Add Sender (confirm the 6-digit code emailed to you)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=7xxxxx@smtp-brevo.com
SMTP_PASS=your_smtp_master_key

# The VERIFIED sender shown as "From" on emails.
MAIL_FROM=UFABWU Portal <nalwogatracy46@gmail.com>

# Port the server listens on.
PORT=3000
